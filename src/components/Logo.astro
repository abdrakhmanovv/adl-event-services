---
/**
 * Логотип ADL Event Services: шрифтовой знак без значка.
 * Крупное «ADL» и рядом в две строки «Event Services» через тонкую вертикальную черту.
 * Цвет наследуется от родителя, поэтому одинаково работает на тёмной главной и светлых страницах.
 */
interface Props {
  /** высота знака в пикселях, примерно высота строки «ADL» */
  size?: number;
  class?: string;
}
const { size = 34, class: className = '' } = Astro.props;
---

<span class:list={['logo-mark', className]} style={`--logo-size: ${size}px`}>
  <span class="logo-mark__name">ADL</span>
  <span class="logo-mark__sub">
    <span>Event</span>
    <span>Services</span>
  </span>
</span>

<style>
  .logo-mark {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--logo-size) * 0.3);
    line-height: 1;
    white-space: nowrap;
    color: inherit;
  }

  .logo-mark__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--logo-size) * 0.72);
    letter-spacing: -0.02em;
  }

  .logo-mark__sub {
    display: grid;
    gap: 1px;
    padding-left: calc(var(--logo-size) * 0.3);
    border-left: 1px solid currentColor;
    font-family: var(--font-text);
    font-weight: 500;
    font-size: calc(var(--logo-size) * 0.33);
    line-height: 1.05;
    letter-spacing: 0.01em;
    opacity: 0.85;
  }
</style>
