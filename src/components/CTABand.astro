---
import Icon from './Icon.astro';
import { url } from '@/lib/url';
import { contactLinks } from '@/content/ru/site';

interface Props {
  title?: string;
  text?: string;
  formHref?: string;
}
const {
  title = 'Не нашли нужную услугу?',
  text = 'Опишите задачу. Если её нет в списке, мы постараемся организовать решение через нашу сеть партнёров в Астане.',
  formHref = '/contacts#form',
} = Astro.props;
---

<section class="section cta-band">
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light btn--lg" href={url(formHref)}>Связаться с координатором</a>
      <a class="btn btn--outline-light btn--lg" href={contactLinks.whatsapp()} target="_blank" rel="noopener">
        <Icon name="message-circle" />WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--night-2);
    color: var(--cream);
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) auto;
    gap: var(--space-7);
    align-items: center;
  }

  .cta-band .lead {
    color: var(--cream-70);
    margin-top: var(--space-3);
  }

  @media (max-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
